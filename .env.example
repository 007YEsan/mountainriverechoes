# 山河回响 —— 环境变量样例
# 复制为 .env(该文件已被 .gitignore 排除, 不会误提交)后按需修改。
# 桌面端双击 exe 使用时通常不需要任何配置, 以下全是可选项。

# ---- 运行环境 ----
# development | production
MRE_ENV=development
# 是否输出调试级日志(会把异常详情回给前端, 仅开发用)
MRE_DEBUG=false

# ---- 网络 ----
# 默认只监听本机回环地址。若改成 0.0.0.0 暴露到局域网, 必须同时设置 MRE_API_TOKEN,
# 否则应用启动时会直接拒绝启动(避免局域网裸奔)。
MRE_HOST=127.0.0.1
MRE_PORT=8766
# 非本机访问时必填; 请求头带 X-Api-Token 即可
# MRE_API_TOKEN=
# 显式列出允许的跨域来源(逗号分隔), 不允许通配符
# MRE_CORS_ORIGINS=http://localhost:5173

# ---- 数据与日志 ----
# 未设置时用系统用户数据目录:
#   Windows: %LOCALAPPDATA%\MountainRiverEchoes\YunnanUniversity
#   macOS:   ~/Library/Application Support/MountainRiverEchoes
# MRE_DATA_DIR=
# 数据库文件位置(默认在 MRE_DATA_DIR 下)
# MRE_DB_PATH=
# 下载的音乐存放目录
# MRE_DOWNLOAD_DIR=
# MRE_LOG_DIR=
# MRE_LOG_LEVEL=INFO
# 结构化 JSON 日志(便于采集)或人类可读格式
MRE_LOG_JSON=true

# ---- 性能 ----
# 索引缓存秒数(曲库很大, 别设 0)
MRE_INDEX_TTL=300
# 检索分页
MRE_SEARCH_PAGE=60
MRE_SEARCH_MAX=200
# 最少检索字数
MRE_SEARCH_MIN_Q=2
# 并发下载数
MRE_DOWNLOAD_WORKERS=4

# ---- 曲库迁移来源(仅开发/CI 用) ----
# 旧版 webui/ethnos_cache 目录; 打包产物不需要
# MRE_LEGACY_CACHE_DIR=./webui/ethnos_cache
# MRE_LEGACY_UI_STATE=./webui/ui_state.json
